#!/usr/bin/env bash
# Tropico -- launcher.
#
#   tropico                  play
#   tropico --monitor NAME   run on another monitor for one launch
#   tropico --list           show monitors, modes and installed art sets
#   tropico --log            capture a trace next to the game, for bug reports
#
# THE RULE: LAUNCH IT FROM THE MONITOR YOU WANT TO PLAY ON.
#
# Two different things decide the outcome and they must be made to agree
# (FINDINGS 76):
#
#   PLACEMENT  the desktop opens the window on the monitor you launched from --
#              the terminal, or the screen whose applications menu you clicked.
#   SIZE       Wine measures only the PRIMARY monitor, so that is what the game
#              can be sized for.
#
# Left alone they disagree the moment your main monitor is not the primary: the
# game opens on the right screen at the wrong resolution. So the launcher reads
# which monitor you are on and makes THAT one primary for the run, restoring your
# primary afterwards. --monitor overrides the choice.
#
# The game runs inside a BORDERLESS Wine virtual desktop sized to that monitor,
# with the artwork generated for the same size.
#
# The virtual desktop is what makes this reliable rather than hopeful. Inside it
# the game sees ONE screen whose origin is (0,0), so the multi-monitor geometry
# that produces DirectDraw #150 -- a window on a monitor Wine did not measure,
# sitting at negative coordinates -- cannot arise at all (FINDINGS 76). Placement
# stops being a correctness problem and becomes at worst a cosmetic one, and
# nothing has to touch your display layout to achieve it.
#
# This is the SHIPPING launcher. tools/tropico-gog.sh is the test harness and is
# NOT interchangeable: it exposes a dozen research knobs TESTING.md depends on.
set -eu

# s90: tell the proxy that this launcher has already chosen the monitor, so it
# does not choose a second time from inside the game (they would disagree).
export TROPICO_LAUNCHER=1

SELF="$(cd "$(dirname "$0")" && pwd)"
. "$SELF/tropico-common.sh"

# Launched from the applications menu there is no terminal, so anything printed is
# simply lost -- including the reason the game did not start. Mirror everything to a
# log beside the game, and put real problems in front of the user with zenity when
# there is no tty to read.
GUI=0; [ -t 1 ] || GUI=1
LOGF=""
say()  { echo "$*"; [ -n "$LOGF" ] && printf '%s\n' "$*" >> "$LOGF" || true; }
warn() { say "!! $*"
         [ "$GUI" = 1 ] && command -v zenity >/dev/null 2>&1 &&
           zenity --warning --title=Tropico --width=420 --text="$*" >/dev/null 2>&1 || true; }
fail() { say "!! $*"
         [ "$GUI" = 1 ] && command -v zenity >/dev/null 2>&1 &&
           zenity --error --title=Tropico --width=420 --text="$*" >/dev/null 2>&1 || true
         exit 1; }

MONITOR=""; LOG=0; LIST=0
while [ $# -gt 0 ]; do
  case "$1" in
    --monitor|-m) MONITOR="${2:-}"; shift 2 ;;
    --log)        LOG=1; shift ;;
    --list|-l)    LIST=1; shift ;;
    --help|-h)    sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "!! unknown option '$1' (try --help)" >&2; exit 1 ;;
  esac
done

GAMEDIR="$(tropico_find_dir)"
if [ -z "$GAMEDIR" ]; then
  fail "Could not find Tropico. Set TROPICO_DIR to the folder holding Tropico.EXE."
fi
LOGF="$GAMEDIR/tropico-launcher.log"
: > "$LOGF" 2>/dev/null || LOGF=""

if [ "$LIST" = 1 ]; then
  echo "Monitors:"
  tropico_outputs | while read -r n m p; do
    printf "   %-12s %-10s%s\n" "$n" "$m" "$([ "$p" = primary ] && echo '  (primary)')"
  done
  echo
  "$SELF/tropico-setmode.sh" --list
  exit 0
fi

# Two mechanisms, and the whole job is making them agree (FINDINGS 78):
#
#   PLACEMENT  the desktop opens the window on the monitor you are launching from
#              -- measured on COSMIC as the one under the POINTER
#   SIZE       Wine measures only the PRIMARY, so that is the largest the game can be
#
# This is not a Tropico problem and there is no API for it: the standard advice
# across the Linux gaming world is "make that monitor primary and launch from it",
# and gamescope -- Valve's own tool for this -- still has selecting its output as an
# open, unimplemented request. So the launcher automates exactly that advice: read
# which monitor you are launching from, and MAKE IT PRIMARY for the run.
RESTORE_PRIMARY=""
restore_primary() {
  [ -n "$RESTORE_PRIMARY" ] || return 0
  _p="$RESTORE_PRIMARY"; RESTORE_PRIMARY=""
  xrandr --output "$_p" --primary 2>/dev/null || true
}
# Where is this being launched from? The POINTER, measured: hovering a second
# monitor without clicking anything -- so focus stays behind on the first -- still
# opens the game under the mouse. An earlier version asked _NET_ACTIVE_WINDOW on the
# theory that placement follows focus; it does not, and that made this case worse.
if [ -z "$MONITOR" ]; then
  MONITOR="$(tropico_launch_output || true)"
fi
if [ -n "$MONITOR" ]; then
  tropico_outputs | awk -v o="$MONITOR" '$1==o{f=1} END{exit !f}' \
    || fail "'$MONITOR' is not a connected monitor. Run 'tropico --list' to see them."
  CUR="$(tropico_outputs | awk '$3=="primary"{print $1; exit}')"
  if [ "$CUR" != "$MONITOR" ]; then
    trap restore_primary EXIT INT TERM HUP
    RESTORE_PRIMARY="$CUR"
    xrandr --output "$MONITOR" --primary || fail "Could not make $MONITOR the primary monitor."
    say "== $MONITOR is primary for this run (was $CUR; it will be put back)"
  fi
fi
# ORDER IS LOAD-BEARING: MEASURE AFTER THE PRIMARY SWITCH, NEVER BEFORE.
#
# The block above may have just made a different output primary. Everything below --
# and the proxy itself, which measures the display for real at launch -- must see the
# display in the state the GAME will run in, not the state the desktop was idling in.
# Measured: a 2560x1440 panel scaled to 200%, whose idle `xrandr` reports 1280x720,
# yields the correct 2560x1440 only because these two lines run after the switch.
#
# This is currently correct BY LINE ORDER ALONE -- there is no assertion holding it in
# place, so a refactor that hoists the measurement for tidiness would break it silently
# and the symptom would be a wrong art set rather than an error. Keep them below.
WANT="$(tropico_primary_mode || true)"
MONITOR="$(tropico_outputs | awk '$3=="primary"{print $1; exit}')"
if [ -z "$WANT" ]; then
  fail "Could not read any monitor's resolution. Is xrandr installed, and is DISPLAY set?"
fi
# A monitor whose own mode the patch cannot use -- a width that is not a multiple of
# 4 shears (FINDINGS 10), 1366x768 being the common case -- stops here.
#
# There used to be a fallback on this branch: `tropico_best_mode` was to pick the
# largest mode the monitor actually offers. It is DEFINED NOWHERE and never was, and
# the call swallowed its own failure with `|| true`, so ALT was unconditionally empty
# and this branch has only ever reached the `fail` below. Removing it changes no
# behaviour whatever; it just stops the code claiming a fallback that does not exist.
# If the fallback is wanted, it is a new feature and needs writing, not restoring.
if ! tropico_validate_mode "${WANT%x*}" "${WANT#*x}" 2>/dev/null; then
  fail "$WANT cannot be used by this patch: $(tropico_validate_mode "${WANT%x*}" "${WANT#*x}" 2>&1 >/dev/null || true)"
fi

# THE ART IS NO LONGER THIS SCRIPT'S JOB. It used to run tropico-setmode.sh here,
# which generated the set in Python (~13 s) into artsets\<WxH>\ and then copied it
# into data/ -- 132 MB written twice at 4K, before the game had even started.
#
# The proxy now generates it in C once it has measured the display for real, in about
# a second, straight into data/. Measured at 3840x2160: 20 s of launcher became 1.09 s
# in-process (FINDINGS 97). So the first launch at a new resolution spends a second
# inside the game rather than twenty in front of it, and this script is left with the
# job only it can do: choosing the monitor and putting the primary back.

case "$GAMEDIR" in
  *steamapps*) TAG="steam" ;;
  *)           TAG="gog"   ;;
esac
export WINEPREFIX="${WINEPREFIX:-$HOME/.wine-tropico-$TAG}"
export WINEARCH=win32
export DISPLAY="${DISPLAY:-:1}"

if [ "$LOG" = 1 ]; then
  export WINEDEBUG="+ddraw"
  TRACE="$GAMEDIR/tropico-trace.log"
  say "== tracing to $TRACE"
else
  export WINEDEBUG="${WINEDEBUG:--all}"
  TRACE=""
fi

# Borderless: strip Wine's window decorations, or the virtual desktop arrives with
# a title bar wrapped around the game. Prefix-wide, and harmless -- this prefix
# runs one game.
wine reg add 'HKCU\Software\Wine\X11 Driver' /v Decorated /t REG_SZ /d N /f >/dev/null 2>&1 || true
# The desktop SIZE goes on the command line, never through the registry. The
# registry route has a trap that cost this project two invalid test runs: `wine reg`
# itself starts a wineserver, which creates the desktop from the value as it was
# BEFORE the write, so the next launch silently uses the previous size.
wine reg delete 'HKCU\Software\Wine\Explorer' /v Desktop /f >/dev/null 2>&1 || true
wineserver -k 2>/dev/null || true
wineserver -w 2>/dev/null || true

say "== Tropico  $WANT"
cd "$GAMEDIR"
# ABSOLUTE WINDOWS PATH, not a relative one. `wine explorer` given a relative path
# silently starts nothing: no window, no error, no log. Measured, and it looks
# exactly like a game that crashed instantly.
EXE="$(winepath -w ./Tropico.EXE 2>/dev/null || true)"
[ -n "$EXE" ] || fail "Could not resolve Tropico.EXE to a Windows path (is the wineprefix healthy?)"
# Ask the WM to fullscreen the virtual desktop once it appears. Borderless alone is
# not fullscreen: without this the window is placed like any other, so it can sit
# offset with panels over it. Backgrounded and best-effort -- it must never be able
# to stop the game launching.
python3 "$SELF/tropico-fullscreen.py" Tropico 30 >/dev/null 2>&1 &
if [ -n "$TRACE" ]; then
  wine explorer "/desktop=Tropico,$WANT" "$EXE" >"$TRACE" 2>&1 || true
else
  wine explorer "/desktop=Tropico,$WANT" "$EXE" >/dev/null 2>&1 || true
fi
wineserver -w 2>/dev/null || true
