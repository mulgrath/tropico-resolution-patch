#!/usr/bin/env bash
# Tropico -- launcher.
#
#   tropico                  play
#   tropico --monitor NAME   run on a specific monitor, just for this launch
#   tropico --list           show monitors, modes and installed art sets
#   tropico --exclusive      turn the other monitors off for the run (see below)
#   tropico --log            capture a trace next to the game, for bug reports
#
# THE RULE: LAUNCH IT FROM THE MONITOR YOU WANT TO PLAY ON.
#
# The launcher makes that monitor primary for the run and matches the game's
# resolution and artwork to it, then puts your primary back afterwards. Wine
# measures only the primary monitor (FINDINGS 18), so aligning the two is what
# keeps the game on the screen you are looking at -- and mismatching them is the
# DirectDraw #150 error (FINDINGS 74).
#
# This is the SHIPPING launcher. tools/tropico-gog.sh is the test harness and is
# NOT interchangeable: it defaults to a Wine virtual desktop and exposes a dozen
# research knobs.
set -eu

SELF="$(cd "$(dirname "$0")" && pwd)"
. "$SELF/tropico-common.sh"

MONITOR=""; LOG=0; EXCLUSIVE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --monitor|-m) MONITOR="${2:-}"; shift 2 ;;
    --exclusive|-x) EXCLUSIVE=1; shift ;;
    --log)        LOG=1; shift ;;
    --list|-l)    LIST=1; shift ;;
    --help|-h)
      sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "!! unknown option '$1' (try --help)" >&2; exit 1 ;;
  esac
done

GAMEDIR="$(tropico_find_dir)"
if [ -z "$GAMEDIR" ]; then
  echo "!! Could not find Tropico. Set TROPICO_DIR to the folder holding Tropico.EXE." >&2
  exit 1
fi

if [ "${LIST:-0}" = 1 ]; then
  echo "Monitors:"
  xrandr --query 2>/dev/null | awk '/ connected/{
      mode="?"; for(i=3;i<=NF;i++) if($i ~ /^[0-9]+x[0-9]+\+/){ split($i,a,"+"); mode=a[1]; break }
      printf "   %-12s %-10s%s\n", $1, mode, (/ primary /?"  (primary)":"") }'
  echo
  "$SELF/tropico-setmode.sh" --list
  exit 0
fi

# Pick the monitor: the one named with --monitor, else the one the pointer is on,
# i.e. the screen the game is being launched from. Whichever it is, it is made
# primary for this run only and restored on ANY exit, including Ctrl-C -- leaving
# someone's primary monitor moved because a game crashed is not acceptable.
RESTORE_PRIMARY=""
RESTORE_LAYOUT=""
restore_primary() {
  # Outputs first, then primary: turning a monitor back on can reset which output
  # is primary, so restoring primary before the layout would be undone.
  if [ -n "$RESTORE_LAYOUT" ]; then
    OLD="$IFS"; IFS='
'
    for _r in $RESTORE_LAYOUT; do
      IFS="$OLD"; set -- $_r
      xrandr --output "$1" --mode "$2" --pos "$3" 2>/dev/null || true
      IFS='
'
    done
    IFS="$OLD"
    RESTORE_LAYOUT=""
  fi
  if [ -n "$RESTORE_PRIMARY" ]; then
    xrandr --output "$RESTORE_PRIMARY" --primary 2>/dev/null || true
    RESTORE_PRIMARY=""
  fi
}
if [ -z "$MONITOR" ]; then
  # Not an error if this fails -- on a single-monitor machine, or anywhere the X
  # pointer cannot be read, the current primary is already the right answer.
  MONITOR="$(tropico_pointer_output || true)"
fi
if [ -n "$MONITOR" ] && command -v xrandr >/dev/null 2>&1; then
  if ! xrandr --query | grep -q "^${MONITOR} connected"; then
    echo "!! '$MONITOR' is not a connected monitor. Try --list." >&2
    exit 1
  fi
  CUR="$(xrandr | awk '/ primary /{print $1; exit}')"
  if [ "$CUR" != "$MONITOR" ]; then
    trap restore_primary EXIT INT TERM
    RESTORE_PRIMARY="$CUR"
    xrandr --output "$MONITOR" --primary
    echo "== $MONITOR is now primary for this run (was $CUR; it will be put back)"
  fi
fi

# --exclusive: turn every OTHER monitor off for the run.
#
# This exists because placement cannot be won from inside. Measured (FINDINGS 75):
# the game's fullscreen window is positioned from the surface's PHYSICAL output,
# which the compositor owns -- at mode-set time the window is on the right monitor,
# and it is moved to the other one afterwards, undoing any SetWindowPos within
# 100 ms. With one output enabled there is nowhere else for it to go.
#
# The layout is restored on ANY exit including Ctrl-C. It is still a blunt
# instrument: windows on the disabled monitor reflow and are not put back.
if [ "$EXCLUSIVE" = 1 ] && [ -n "$MONITOR" ]; then
  SAVE=""; OTHERS=""
  while read -r name mode prim; do
    [ "$mode" = "-" ] && continue
    SAVE="$SAVE$name $mode $(xrandr --query | awk -v o="$name" '$1==o{for(i=3;i<=NF;i++) if($i ~ /^[0-9]+x[0-9]+\+/){sub(/^[0-9]+x[0-9]+/,"",$i); sub(/^\+/,"",$i); gsub(/\+/,"x",$i); print $i; exit}}')
"
    [ "$name" != "$MONITOR" ] && OTHERS="$OTHERS $name"
  done <<SAVEEOF
$(tropico_outputs)
SAVEEOF
  if [ -n "$OTHERS" ]; then
    trap restore_primary EXIT INT TERM HUP
    RESTORE_LAYOUT="$SAVE"
    for o in $OTHERS; do
      echo "== turning $o off for this run"
      xrandr --output "$o" --off 2>/dev/null || true
    done
  fi
fi

# Match the art set to the monitor the game is about to measure. Staged sets make
# this a fraction of a second; an unstaged one is generated once and then staged.
WANT="$(tropico_primary_mode || true)"
HAVE="$(cat "$GAMEDIR/data/ARTSET-MODE.txt" 2>/dev/null || true)"
if [ -n "$WANT" ] && [ -n "$HAVE" ] && [ "$WANT" != "$HAVE" ]; then
  echo "== switching to $WANT"
  "$SELF/tropico-setmode.sh" "${WANT%x*}" "${WANT#*x}" >/dev/null
fi

case "$GAMEDIR" in
  *steamapps*) TAG="steam" ;;
  *)           TAG="gog"   ;;
esac
export WINEPREFIX="${WINEPREFIX:-$HOME/.wine-tropico-$TAG}"
export WINEARCH=win32
export DISPLAY="${DISPLAY:-:1}"

if [ "$LOG" = 1 ]; then
  export WINEDEBUG="+ddraw"
  TRACE="$GAMEDIR/tropico-trace.log"
  echo "== tracing to $TRACE"
else
  export WINEDEBUG="${WINEDEBUG:--all}"
  TRACE=""
fi

# No Wine virtual desktop: the game talks to the real display. This is the tier-1
# configuration (FINDINGS 13) and it is why the game can reach a real mode at all.
# The `wine reg` call itself starts wineserver, so the kill afterwards is required
# or the next launch silently joins a stale desktop.
wine reg delete 'HKCU\Software\Wine\Explorer' /v Desktop /f >/dev/null 2>&1 || true
wineserver -k 2>/dev/null || true
wineserver -w 2>/dev/null || true

echo "== Tropico  ${WANT:-?}"
cd "$GAMEDIR"
if [ -n "$TRACE" ]; then
  wine Tropico.EXE >"$TRACE" 2>&1 || true
else
  wine Tropico.EXE >/dev/null 2>&1 || true
fi
wineserver -w 2>/dev/null || true
