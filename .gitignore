# NEVER commit game binaries or user config - ship only original code.
*.EXE
*.exe
*.CFG
*.cfg
*.PK2
*.xdt
*.lng

# raw traces are large; commit them gzipped
logs/*.log

# Generated UI art is DERIVED GAME ART, not our code -- same rule as the binaries
# above. It is reproducible from the user's own archives in one command:
#   tools/tropico-set-resolution.sh WIDTH HEIGHT
known-good/menu-art-*/
known-good/fonts-scale*/
*.i06
*.i08
*.i10
*.i12
*.i16

# Local backups of generated art. Personal-use copies; regenerable at any time with
# tools/tropico-set-resolution.sh, so they are kept out of history by choice, not
# because they are unimportant.
generated/

# Python byte-code: never ship it, never commit it.
__pycache__/
*.pyc

# Release tarballs. tools/make-release.sh rebuilds them from `git ls-files` at any
# time, so keeping them in history would only add a copy of the tree per release.
dist/

# Scratch builds of the proxy. Only proxy/binkw32.dll and known-good/binkw32.dll
# are real artifacts; anything else is a variant from an experiment.
proxy/binkw32_*.dll
